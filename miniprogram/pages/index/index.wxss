/** pages/index/index.wxss **/

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #eef3fb 0%, #f7f9fd 220rpx, #f3f5f9 100%);
  padding: 26rpx 24rpx 56rpx;
  box-sizing: border-box;
}

.hero-card {
  position: relative;
  margin-bottom: 16rpx;
  min-height: 312rpx;
  padding: 44rpx 36rpx 32rpx;
  border-radius: 32rpx;
  background:
    radial-gradient(circle at 76% 34%, rgba(177, 209, 255, 0.48) 0, rgba(177, 209, 255, 0.18) 92rpx, rgba(177, 209, 255, 0) 180rpx),
    radial-gradient(circle at 88% 78%, rgba(202, 223, 255, 0.42) 0, rgba(202, 223, 255, 0.12) 86rpx, rgba(202, 223, 255, 0) 176rpx),
    linear-gradient(135deg, #fbfdff 0%, #f3f8ff 56%, #eef5ff 100%);
  border: 2rpx solid rgba(220, 230, 244, 0.9);
  box-shadow: 0 18rpx 46rpx rgba(55, 79, 118, 0.1);
  overflow: hidden;
}

.hero-copy {
  position: relative;
  z-index: 2;
  width: 330rpx;
}

.hero-image {
  position: absolute;
  right: -88rpx;
  bottom: -12rpx;
  z-index: 1;
  margin: 0;
  /* width: 452rpx; */
  height: 356rpx;
}

.hero-title-dark {
  font-size: 42rpx;
  font-weight: 800;
  color: #151515;
  line-height: 1.22;
}

.hero-title-accent {
  margin-top: 6rpx;
  font-size: 56rpx;
  font-weight: 800;
  color: #2d6ff8;
  line-height: 1.05;
}

.hero-desc {
  margin-top: 16rpx;
  width: 300rpx;
  font-size: 28rpx;
  color: #7c8aa3;
  line-height: 1.6;
}

.hero-indicator {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 40rpx;
}

.hero-indicator-line {
  width: 46rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #2d6ff8;
}

.hero-indicator-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #94b7ff;
}

.hero-spark {
  position: absolute;
  color: rgba(189, 213, 255, 0.96);
  font-size: 32rpx;
  line-height: 1;
  z-index: 2;
}

.hero-spark-one {
  top: 52rpx;
  left: 330rpx;
}

.hero-spark-two {
  top: 96rpx;
  left: 388rpx;
  font-size: 24rpx;
}

.actions-card {
  margin-bottom: 20rpx;
}

.collect-card {
  margin-bottom: 20rpx;
  padding: 30rpx 28rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 16rpx 38rpx rgba(42, 57, 92, 0.08);
}

.collect-header {
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #edf2fb;
}

.collect-tag {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(77, 147, 255, 0.12);
  color: #2f6ff7;
  font-size: 22rpx;
  font-weight: 700;
}

.collect-title {
  margin-top: 18rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #223459;
  line-height: 1.4;
}

.collect-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #7e8ea9;
  line-height: 1.6;
}

.collect-form {
  padding-top: 10rpx;
}

.collect-section-title {
  margin-top: 28rpx;
  margin-bottom: 18rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #1f3158;
}

.collect-field {
  margin-bottom: 20rpx;
}

.collect-label {
  margin-bottom: 14rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #536e9f;
}

.collect-input,
.collect-picker,
.collect-textarea {
  width: 100%;
  padding: 24rpx 22rpx;
  border-radius: 24rpx;
  background: #f7faff;
  border: 2rpx solid #edf2fb;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #223459;
}

.collect-picker {
  min-height: 76rpx;
  line-height: 1.3;
  color: #a0adbf;
}

.collect-picker.is-filled {
  color: #223459;
}

.collect-textarea {
  min-height: 148rpx;
  line-height: 1.6;
}

.collect-option-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.collect-option {
  min-width: 124rpx;
  padding: 18rpx 22rpx;
  border-radius: 999rpx;
  background: #f7faff;
  border: 2rpx solid #edf2fb;
  box-sizing: border-box;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #7e8ea9;
}

.collect-option.is-active {
  background: linear-gradient(135deg, #4d93ff 0%, #2f6ff7 100%);
  border-color: transparent;
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(77, 147, 255, 0.18);
}

.collect-footer {
  margin-top: 10rpx;
}

.collect-saved-tip {
  margin-bottom: 18rpx;
  font-size: 22rpx;
  color: #7e8ea9;
  line-height: 1.5;
}

.collect-button-row {
  display: flex;
  gap: 18rpx;
}

.collect-button {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.collect-button::after {
  border: none;
}

.collect-button-light {
  background: #eef4ff;
  color: #2f6ff7;
}

.collect-button-primary {
  background: linear-gradient(135deg, #4d93ff 0%, #2f6ff7 100%);
  color: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(47, 111, 247, 0.2);
}

.actions-swiper {
  height: 860rpx;
}

/* 首页轮播卡片用于承载查分与 AI 问答两个独立入口。 */
.banner-card {
  height: 100%;
  margin: 0;
  box-sizing: border-box;
  border-radius: 44rpx;
  overflow: hidden;
  box-shadow: 0 24rpx 56rpx rgba(58, 70, 102, 0.12);
}

.banner-card-score {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  /* padding: 20rpx; */
  background: #ffffff;
}

.score-panel {
  flex: 1;
  padding: 34rpx 28rpx 26rpx;
  border-radius: 36rpx;
  background: linear-gradient(180deg, #f6f6f2 0%, #f2f2ee 100%);
}

.score-panel-header-main {
  width: 100%;
}

.score-panel-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #222222;
}

.score-panel-value-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
}

.score-panel-value {
  font-size: 82rpx;
  font-weight: 800;
  color: #111111;
  line-height: 1;
}

.score-panel-unit {
  margin-top: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #5e5e5e;
}

.score-panel-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 50rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #f1ee55;
  color: #262626;
  font-size: 24rpx;
  font-weight: 700;
}

.score-panel-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #5f615e;
  line-height: 1.5;
}

.score-panel-summary {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #90928f;
  line-height: 1.5;
}

.score-metric-list {
  display: flex;
  margin-top: 30rpx;
  padding: 0 10rpx;
}

.score-metric-item {
  flex: 1;
  text-align: center;
  position: relative;
}

.score-metric-item::after {
  content: '';
  position: absolute;
  top: 8rpx;
  right: 0;
  width: 2rpx;
  height: 76rpx;
  background: rgba(150, 150, 150, 0.18);
}

.score-metric-item:last-child::after {
  display: none;
}

.score-metric-value {
  font-size: 34rpx;
  font-weight: 800;
  color: #202020;
}

.score-metric-label {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8a8c89;
}

.score-wave-chart {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 12rpx;
  height: 220rpx;
  margin-top: 36rpx;
  padding: 0 8rpx;
}

.score-wave-bar {
  width: 10rpx;
  border-radius: 999rpx;
}

.score-wave-bar.tone-soft {
  background: #e6e6e2;
}

.score-wave-bar.tone-dark {
  background: #111111;
}

.score-wave-bar.tone-strong {
  background: #2f2f2f;
}

.score-footer {
  display: flex;
  justify-content: space-between;
  padding: 28rpx 26rpx 16rpx;
}

.score-footer-item {
  flex: 1;
}

.score-footer-value-row {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
}

.score-footer-value {
  font-size: 34rpx;
  font-weight: 800;
  color: #1d1d1d;
}

.score-footer-unit {
  margin-bottom: 4rpx;
  font-size: 22rpx;
  color: #6b6f6d;
}

.score-footer-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7f8381;
}

.banner-card-ai {
  background: transparent;
  box-shadow: none;
}

.ai-panel-shell {
  height: 100%;
  padding: 16rpx;
  border-radius: 44rpx;
  background: linear-gradient(180deg, #fcfcfa 0%, #f7f9f5 100%);
  border: 2rpx solid rgba(198, 202, 195, 0.45);
  box-shadow: 0 24rpx 56rpx rgba(58, 70, 102, 0.12);
  box-sizing: border-box;
}

.ai-panel-top {
  padding: 16rpx 16rpx 0;
}

.ai-panel-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.ai-panel-eyebrow {
  font-size: 24rpx;
  color: #d9dbd4;
  line-height: 1;
}

.ai-panel-title {
  margin-top: 10rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #1a1a1a;
}

.ai-panel-desc {
  margin-top: 12rpx;
  font-size: 30rpx;
  color: #767976;
  line-height: 1.55;
}

.ai-panel-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #f1ee55;
  color: #1f1f1f;
  font-size: 22rpx;
  font-weight: 700;
}

.ai-feature-list {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
  padding-bottom: 22rpx;
  border-bottom: 2rpx solid rgba(196, 200, 193, 0.72);
}

.ai-feature-item {
  flex: 1;
  min-height: 60rpx;
  /* padding: 20rpx 18rpx; */
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.ai-feature-item + .ai-feature-item {
  padding-left: 28rpx;
  border-left: 2rpx solid rgba(196, 200, 193, 0.72);
}

.ai-feature-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(42, 57, 92, 0.08);
  font-size: 24rpx;
  font-weight: 700;
  color: #202020;
}

.ai-feature-title {
  margin-top: 22rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #222222;
  line-height: 1.35;
}

.ai-data-card {
  display: flex;
  gap: 22rpx;
  margin-top: 22rpx;
  padding: 28rpx 24rpx 22rpx;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  border-bottom: 2rpx solid rgba(196, 200, 193, 0.72);
}

.ai-data-card-copy {
  width: 190rpx;
}

.ai-data-card-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #202020;
}

.ai-data-card-value-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.ai-highlight-value {
  font-size: 78rpx;
  font-weight: 800;
  color: #111111;
  line-height: 1;
}

.ai-highlight-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: inset 0 0 0 2rpx rgba(224, 226, 219, 0.8);
  font-size: 22rpx;
  font-weight: 700;
  color: #4a4d49;
}

.ai-data-card-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #4d4f4c;
}

.ai-trend-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding-left: 24rpx;
  border-left: 2rpx solid rgba(196, 200, 193, 0.72);
}

.ai-trend-list {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 230rpx;
  padding: 0 10rpx 0 0;
}

.ai-trend-item {
  display: flex;
  align-items: flex-end;
  height: 100%;
}

.ai-trend-bar {
  width: 8rpx;
  border-radius: 999rpx;
}

.ai-trend-bar.tone-light {
  background: #d7d8d4;
}

.ai-trend-bar.tone-mid {
  background: #bfc1bd;
}

.ai-trend-bar.tone-focus {
  width: 10rpx;
  background: #141414;
}

.ai-trend-label {
  margin-top: 12rpx;
  text-align: right;
  font-size: 22rpx;
  font-weight: 700;
  color: #6b6f6a;
}

.ai-panel-bottom {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 16rpx 16rpx;
}

.ai-panel-bottom-summary,
.ai-panel-bottom-quick {
  flex: 1;
  min-height: 156rpx;
  padding: 24rpx 22rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
}

.ai-panel-bottom-summary {
  background: transparent;
  box-shadow: none;
}

.ai-panel-bottom-main-value-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.ai-panel-bottom-main-value {
  font-size: 62rpx;
  font-weight: 800;
  color: #111111;
  line-height: 1;
}

.ai-panel-bottom-main-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #dff0c7;
  color: #2f3b25;
  font-size: 22rpx;
  font-weight: 700;
}

.ai-panel-bottom-main-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #4f544f;
}

.ai-panel-bottom-quick {
  background: linear-gradient(135deg, #dff2d0 0%, #d1edbf 100%);
  border-left: 2rpx solid rgba(196, 200, 193, 0.72);
}

.ai-panel-bottom-quick-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #1f231e;
}

.ai-panel-bottom-quick-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(31, 35, 30, 0.72);
  line-height: 1.45;
}

.ai-panel-bottom-quick-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 18rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: #111111;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.ai-panel-bottom-stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ai-panel-bottom-stat {
  flex: 1;
  text-align: left;
}

.ai-panel-bottom-stat-value {
  font-size: 32rpx;
  font-weight: 800;
  color: #111111;
  line-height: 1.2;
}

.ai-panel-bottom-stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6f746f;
}

.ai-panel-bottom-action {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 20rpx;
  height: 68rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #1e1f1e;
  font-size: 26rpx;
  font-weight: 700;
}

.ai-panel-bottom-action-arrow {
  font-size: 34rpx;
}

.action-card {
  position: relative;
  margin-bottom: 20rpx;
  min-height: 268rpx;
  padding: 42rpx 36rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #4d93ff 0%, #2f6ff7 58%, #5ea3ff 100%);
  box-shadow: 0 20rpx 52rpx rgba(51, 103, 214, 0.24);
  overflow: hidden;
}

.action-card2 {
  margin-bottom: 20rpx;
}

/* 工具 S 作为独立入口卡片展示，不与快捷入口宫格混排。 */
.tool-s-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 32rpx;
  padding: 30rpx 28rpx 26rpx;
  box-shadow: 0 16rpx 38rpx rgba(42, 57, 92, 0.08);
}

.tool-s-entry-copy {
  flex: 1;
  padding-right: 24rpx;
}

.tool-s-entry-tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 138, 71, 0.12);
  color: #ff8a47;
  font-size: 22rpx;
  font-weight: 700;
}

.tool-s-entry-title {
  margin-top: 18rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #223459;
  line-height: 1.3;
}

.tool-s-entry-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #7e8ea9;
  line-height: 1.6;
}

.tool-s-entry-action {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  padding: 0 24rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffb66c 0%, #ff8a47 100%);
  box-shadow: 0 14rpx 28rpx rgba(255, 138, 71, 0.22);
}

.tool-s-entry-action-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.tool-s-entry-action-arrow {
  font-size: 34rpx;
  line-height: 1;
  color: #ffffff;
}

.action-card3 {
  background: rgba(255, 255, 255, 0.96);
  border-radius: 32rpx;
  padding: 30rpx 28rpx 26rpx;
  box-shadow: 0 16rpx 38rpx rgba(42, 57, 92, 0.08);
}

.action-copy {
  position: relative;
  z-index: 2;
  width: 340rpx;
}

.action-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1.35;
}

.action-desc {
  margin-top: 14rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.82);
  line-height: 1.6;
}

.action-button {
  display: inline-flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 30rpx;
  padding: 0 30rpx;
  height: 76rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #2f6ff7;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 14rpx 32rpx rgba(37, 75, 161, 0.22);
}

.action-button-arrow {
  font-size: 34rpx;
  line-height: 1;
}

.action-visual {
  position: absolute;
  right: -44rpx;
  bottom: -30rpx;
  width: 236rpx;
  height: 214rpx;
  transform: scale(1.5);
  transform-origin: right bottom;
}

.visual-panel {
  position: absolute;
  top: 24rpx;
  right: 50rpx;
  width: 116rpx;
  height: 150rpx;
  padding: 18rpx 16rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.32) 0%, rgba(255, 255, 255, 0.18) 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 18rpx 34rpx rgba(48, 94, 194, 0.22);
  transform: rotate(10deg);
}

.visual-panel-top {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.visual-panel-line {
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.52);
}

.visual-panel-line-short {
  width: 54rpx;
}

.visual-panel-body {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 18rpx;
}

.visual-panel-search {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 50%;
  box-sizing: border-box;
}

.visual-panel-search-handle {
  position: absolute;
  right: -10rpx;
  bottom: -10rpx;
  width: 18rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  transform: rotate(45deg);
}

.visual-panel-bars {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
}

.visual-bar {
  width: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
}

.visual-bar-one {
  height: 28rpx;
}

.visual-bar-two {
  height: 40rpx;
}

.visual-bar-three {
  height: 52rpx;
}

.visual-base {
  position: absolute;
  left: 20rpx;
  right: 10rpx;
  border-radius: 999rpx;
}

.visual-base-outer {
  bottom: 14rpx;
  height: 36rpx;
  background: rgba(255, 255, 255, 0.14);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.16);
}

.visual-base-inner {
  bottom: 24rpx;
  left: 42rpx;
  right: 36rpx;
  height: 20rpx;
  background: rgba(255, 255, 255, 0.4);
}

.visual-orbit {
  position: absolute;
  border: 2rpx solid rgba(255, 255, 255, 0.44);
  border-radius: 50%;
}

.visual-orbit-left {
  left: 24rpx;
  top: 76rpx;
  width: 166rpx;
  height: 64rpx;
  transform: rotate(-16deg);
}

.visual-orbit-right {
  right: 8rpx;
  top: 62rpx;
  width: 148rpx;
  height: 58rpx;
  transform: rotate(18deg);
}

.section-head {
  margin-bottom: 26rpx;
}

.section-tag {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
  color: #536e9f;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.section-tag-icon {
  font-size: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f3158;
  line-height: 1.45;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.quick-card {
  position: relative;
  width: calc((100% - 18rpx) / 2);
  min-height: 256rpx;
  padding: 28rpx 24rpx 72rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #f6f9ff 0%, #f9fbff 100%);
  border: 2rpx solid #edf2fb;
  box-sizing: border-box;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.quick-icon {
  width: 70rpx;
  height: 70rpx;
  border-radius: 22rpx;
  font-size: 32rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 24rpx rgba(86, 122, 202, 0.16);
}

.quick-title {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #223459;
  line-height: 1.3;
}

.quick-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #8493ad;
  line-height: 1.6;
}

.quick-arrow {
  position: absolute;
  left: 24rpx;
  bottom: 24rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #7f8eaa;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 18rpx rgba(120, 138, 171, 0.16);
}
