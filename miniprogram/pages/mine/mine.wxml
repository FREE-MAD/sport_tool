  <view class="section-card">
    <view class="section-head">
      <view class="section-tag">查分历史</view>
      <view class="section-title">最近查过的成绩都在这里</view>
      <view class="section-desc">按当前登录用户展示最近 10 条查分记录，点开就能继续回看明细。</view>
    </view>

    <view wx:if="{{historyLoading}}" class="history-status-card">
      <view class="history-status-title">正在加载历史记录</view>
      <view class="history-status-desc">稍等一下，我正在把你最近的查分结果拉出来。</view>
    </view>

    <view wx:elif="{{scoreHistoryList.length > 0}}" class="history-list">
      <view
        class="history-card"
        wx:for="{{scoreHistoryList}}"
        wx:key="id"
        bindtap="openHistoryDetail"
        data-history-id="{{item.id}}"
      >
        <view class="history-card-top">
          <view class="history-meta">
            <view class="history-title">{{item.projectTitle}}</view>
            <view class="history-subtitle">{{item.projectSubtitle}}</view>
          </view>
          <view class="history-score">
            <view class="history-score-value">{{item.totalScoreText}}</view>
            <view class="history-score-label">总分</view>
          </view>
        </view>
        <view class="history-card-body">
          <view class="history-preview">{{item.scorePreviewText}}</view>
        </view>
        <view class="history-card-foot">
          <view class="history-time">{{item.submitTimeText}}</view>
          <view class="history-count">{{item.projectCountText}}</view>
        </view>
      </view>
    </view>

    <view wx:else class="empty-card">
      <view class="empty-title">还没有查分历史</view>
      <view class="empty-desc">{{historyEmptyText}}</view>
    </view>
  </view>

