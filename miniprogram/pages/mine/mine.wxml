<view class="page">
  <view class="hero-card">
    <view class="hero-head">
      <view class="hero-badge">个人中心</view>
      <view wx:if="{{hasUserInfo}}" class="hero-status hero-status--active">已授权</view>
      <view wx:else class="hero-status">待授权</view>
    </view>

    <view class="profile-row">
      <view class="avatar-shell">
        <block wx:if="{{hasUserInfo}}">
          <image class="userinfo-avatar" src="{{userInfo.avatarUrl}}" mode="cover"></image>
        </block>
        <block wx:else>
          <view class="avatar-placeholder">我</view>
        </block>
      </view>

      <view class="profile-copy">
        <block wx:if="{{hasUserInfo}}">
          <view class="profile-name">{{userInfo.nickName}}</view>
          <view class="profile-desc">头像与昵称已同步，这里会继续作为你的常用页面入口。</view>
        </block>
        <block wx:else>
          <view class="profile-name">未授权用户</view>
          <view class="profile-desc">先获取头像昵称也可以，直接使用下方快捷入口也可以。</view>
        </block>
      </view>
    </view>

    <button
      class="profile-btn"
      wx:if="{{!hasUserInfo && canIUseGetUserProfile}}"
      bindtap="getUserProfile"
    >
      获取头像昵称
    </button>
    <button
      class="profile-btn"
      wx:elif="{{!hasUserInfo}}"
      open-type="getUserInfo"
      bindgetuserinfo="getUserInfo"
    >
      获取头像昵称
    </button>

    <view class="profile-stats">
      <view class="stat-card" wx:for="{{stats}}" wx:key="label">
        <view class="stat-value">{{item.value}}</view>
        <view class="stat-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-head">
      <view class="section-tag section-tag--blue">我的偏好</view>
      <view class="section-title">默认查分条件已经帮你记住</view>
      <view class="section-desc">
        <block wx:if="{{hasPreference}}">
          最近一次保存的偏好会优先展示在这里，进入查分页后会自动回填。
        </block>
        <block wx:else>
          你还没有保存默认偏好，去查分页选择一次后，这里会自动同步。
        </block>
      </view>
    </view>

    <view wx:if="{{hasPreference}}" class="preference-card">
      <view class="preference-list">
        <view class="preference-item" wx:for="{{preferenceSummaryRows}}" wx:key="label">
          <view class="preference-label">{{item.label}}</view>
          <view class="preference-value">{{item.value}}</view>
        </view>
      </view>
      <view wx:if="{{preferenceUpdatedAtText}}" class="preference-foot">
        最近更新：{{preferenceUpdatedAtText}}
      </view>
    </view>

    <view wx:else class="empty-card">
      <view class="empty-title">暂未保存默认偏好</view>
      <view class="empty-desc">建议先去查分页完成一次选择，再点击“保存为默认偏好”。</view>
    </view>
  </view>

